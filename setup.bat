@echo off
cd /d "%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; $py = (Get-ChildItem '$env:LOCALAPPDATA\Programs\Python\Python*\python.exe','C:\Python*\python.exe' -ErrorAction SilentlyContinue | Sort-Object FullName -Descending | Select-Object -First 1).FullName; if (-not $py) { Invoke-WebRequest -Uri 'https://www.python.org/ftp/python/3.11.9/python-3.11.9-amd64.exe' -OutFile '$env:TEMP\py311.exe'; $sig = Get-AuthenticodeSignature '$env:TEMP\py311.exe'; if ($sig.Status -ne 'Valid' -or $sig.SignerCertificate.Subject -notmatch 'Python Software Foundation') { throw 'Python installer Authenticode signature verification failed!' }; Start-Process -FilePath '$env:TEMP\py311.exe' -ArgumentList '/quiet InstallAllUsers=0 PrependPath=1 Include_test=0' -Wait; $py = (Get-ChildItem '$env:LOCALAPPDATA\Programs\Python\Python*\python.exe' | Select-Object -First 1).FullName }; & $py -m pip install -r requirements.txt; if (-not (Test-Path 'dist\index.html')) { $npm = (Get-Command npm -ErrorAction SilentlyContinue).Source; if (-not $npm) { Invoke-WebRequest -Uri 'https://nodejs.org/dist/v20.18.0/node-v20.18.0-win-x64.zip' -OutFile '$env:TEMP\node.zip'; $expectedHash = ((Invoke-RestMethod -Uri 'https://nodejs.org/dist/v20.18.0/SHASUMS256.txt') -split [Environment]::NewLine | Where-Object { $_ -match 'node-v20.18.0-win-x64.zip' } | ForEach-Object { ($_ -split '\s+')[0] }).Trim(); $actualHash = (Get-FileHash '$env:TEMP\node.zip' -Algorithm SHA256).Hash.ToLower(); if ($actualHash -ne $expectedHash.ToLower()) { throw 'Node.js SHA-256 checksum verification failed!' }; Expand-Archive -Path '$env:TEMP\node.zip' -DestinationPath '$env:LOCALAPPDATA\Programs' -Force; $nodeDir = (Get-ChildItem '$env:LOCALAPPDATA\Programs\node-v20*-win-x64' | Select-Object -First 1).FullName; $env:Path = '$nodeDir;$env:Path' }; npm install; npm run build }; & '$PSScriptRoot\install_desktop.ps1'"
echo Setup complete! Launch NEXO from your Desktop shortcut.
