@echo off
title NEXO Terminal Installer
cd /d "%~dp0"
echo [1/4] Installing Python packages...
python -m pip install -r backend\requirements.txt
echo [2/4] Installing Node packages...
call npm install
echo [3/4] Building desktop bundle...
call npm run build
echo [4/4] Creating Desktop shortcut...
powershell -ExecutionPolicy Bypass -File "%~dp0install_desktop.ps1"
echo NEXO installed! Launching...
wscript.exe "%~dp0NEXO.vbs"
